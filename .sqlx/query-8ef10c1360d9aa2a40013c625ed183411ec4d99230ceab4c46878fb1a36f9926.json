  "query": "\n                            SELECT\n                                t.id,\n                                t.title,\n                                t.description,\n                                t.created_at AS \"created_at!: DateTime<Utc>\",\n                                t.completed_at AS \"completed_at!: Option<DateTime<Utc>>\",\n                                t.project_id,\n                                t.state_id,\n                                s.name AS state_name\n                            FROM tasks t\n                            JOIN states s ON t.state_id = s.id\n                            WHERE t.project_id = ? AND t.state_id = ?\n                            ORDER BY t.id ASC\n                        ",
