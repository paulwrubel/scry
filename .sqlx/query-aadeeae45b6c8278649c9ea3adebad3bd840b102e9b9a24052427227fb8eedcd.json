  "query": "\n                    SELECT\n                        t.id AS \"id: i64\",\n                        t.title,\n                        t.description,\n                        t.created_at AS \"created_at: DateTime<Utc>\",\n                        t.project_id AS \"project_id: i64\",\n                        t.status_id AS \"status_id: i64\",\n                        t.position AS \"position: i32\"\n                    FROM tasks t\n                    WHERE t.project_id = ?\n                    ORDER BY t.position ASC, t.id ASC\n                ",
