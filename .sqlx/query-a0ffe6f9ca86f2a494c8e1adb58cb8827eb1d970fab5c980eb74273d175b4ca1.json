  "query": "\n                SELECT\n                    c.id,\n                    c.task_id,\n                    c.contents,\n                    c.created_at\n                FROM comments c\n                JOIN tasks t ON t.id = c.task_id\n                WHERE t.project_id = $1\n                ORDER BY c.created_at ASC\n            ",
