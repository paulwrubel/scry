  "query": "\n                SELECT\n                    n.id,\n                    n.task_id,\n                    n.contents,\n                    n.created_at\n                FROM notes n\n                JOIN tasks t ON t.id = n.task_id\n                WHERE t.project_id = ?\n                ORDER BY n.created_at ASC\n            ",
