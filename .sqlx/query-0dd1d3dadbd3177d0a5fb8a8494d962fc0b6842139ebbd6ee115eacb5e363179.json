  "query": "\n                SELECT\n                    id,\n                    project_id,\n                    title,\n                    description,\n                    priority,\n                    status_id,\n                    position,\n                    tags,\n                    created_at\n                FROM tasks\n                WHERE project_id = $1\n                ORDER BY position ASC, id ASC\n            ",
